  "components": [
    {
      "id":    "pad",
      "name":  "Pad_52Type",
      "when":  "pad_symbol != N/A",
      "role":  "reinforcement_pad",
      "thickness_rule": "pad_t_fallback_by_size",
      "length_expr":    "LOPS + E*2 if pipe_size <= small_group_max else LOPS + E*2 + 25*2",
      "_length_comment": "small source-profile group: LOPS + E*2; large group: LOPS + E*2 + 25*2",
      "width_expr":     "OD*pi/3",
      "_width_comment": "120-degree developed width"
    },
    {
      "id":     "wedge",
      "name":   "Angle",
      "when":   "angle_wedge",
      "role":   "angle",
      "spec":   "40*40*5",
      "length": 150,
      "qty":    2,
      "remark": "L40×40×5 側向導引，現場裁切，暂定長=150mm [L40x40x5 side guide, CUT IN FIELD, length provisional=150]"
    },
    {
      "id":     "beam",
      "name":   "H Beam",
      "when":   "C != FB12",
      "role":   "h_section",
      "spec_ref": "C",
      "length_expr": "LOPS if pipe_size <= small_group_max else LOPS+25*2",
      "_length_comment": "small source-profile group: LOPS or D; large group: LOPS + 25*2",
      "remark_template": "由H{C}裁切；長=LOPS+25×2；《購買逻輯》1支H型鵋對分=2組支撐 [CUT FROM H{C}; L=LOPS+25*2; 1 purchased H-beam split in half = 2 supports]"
    },
    {
      "id":       "fab_bottom",
      "name":     "FB_52Type_1",
      "when":     "C == FB12",
      "role":     "generic_plate",
      "thickness": 12,
      "width_expr":  "A",
      "_width_comment": "16~24: main fabricated 12t bottom plate width = table A",
      "length_expr": "LOPS+50",
      "_length_comment": "LOPS + 25*2",
      "remark_template": "T形底板：W=A，L={LOPS+50}(=LOPS+25×2)，t=12mm [T-bottom plate: W=A, L={LOPS+50}(=LOPS+25*2), t=12]"
    },
    {
      "id":       "fab_web",
      "name":     "FB_52Type_2",
      "when":     "C == FB12",
      "role":     "generic_plate",
      "thickness": 12,
      "width_expr": "HOPS",
      "length_expr": "LOPS+50",
      "_length_comment": "LOPS + 25*2",
      "remark_template": "T形腹板：W=HOPS，L={LOPS+50}(=LOPS+25×2)，t=12mm [T-vertical plate: W=HOPS, L={LOPS+50}(=LOPS+25*2), t=12]"
    },
    {
      "id":       "gusset",
      "name":     "FB_52Type_3",
      "when":     "pipe_size >= gusset_min and not (type_id == '54' and pipe_size <= 14)",
      "role":     "generic_plate",
      "thickness_ref": "B",
      "length_expr":   "HOPS",
      "width_expr":    "A",
      "_width_comment": "10~24: reinforcing flat bar width = table A",
      "qty":           4,
      "remark": "高度=HOPS（僅用於計算，非實際制作高）；寬度=A；數量=4 [height=HOPS for calculation only, not fabrication height; width=A; qty=4]"
    },
    {
      "id":       "type54_stopper",
      "name":     "檔板_54Type",
      "when":     "type_id == '54' and pipe_size >= 10 and pipe_size <= 14",
      "role":     "stopper_plate",
      "thickness": 12,
      "length":    40,
      "width":     40,
      "qty":       4,
      "remark": "TYPE-54 10\"~14\" 檔板；40×40×12t，數量=4；右上倒角圖面未標尺寸，重量計算不扣除，僅紀錄外形需求 [TYPE-54 10\"~14\" stopper plate; 40x40x12t qty=4; top-right chamfer not dimensioned, ignored for weight]"
    }
